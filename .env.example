# Application
APP_ENV=development
APP_NAME=Thekua Store
APP_PORT=8080

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=thekua_user
DB_PASSWORD=thekua_password_123
DB_NAME=thekua_store
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=Thekua Store

# Razorpay (Payment Integration)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@thekuastore.com
